# Copie para .env e preencha. O .env NÃO é versionado.
# Os valores saem do `terraform output` em infra/ (ou do portal do Azure).

# Azure AI Speech (Speech to Text)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_LANGUAGE=pt-BR

# Azure AI Language (Text Analytics: sentimento, entidades, Text Analytics for Health)
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
# Text Analytics for Health só aceita a tag genérica "pt" (não "pt-BR") — plano D5
AZURE_TEXT_LANGUAGE=pt

# Vídeo
YOLO_MODEL=yolov8n.pt
YOLO_POSE_MODEL=yolov8n-pose.pt
